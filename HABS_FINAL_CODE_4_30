def download_ecostress_data(aoi_coords, time_range, local_download_folder, task_name='ECOSTRESS_download'):
    user = earthdata_username
    password = earthdata_password
    api = 'https://appeears.earthdatacloud.nasa.gov/api/'
    token_response = req.post(f'{api}login', auth=(user, password)).json()
    if 'token' not in token_response:
        raise ValueError(f"Failed to retrieve API token: {token_response}")
    token = token_response['token']
    head = {'Authorization': f'Bearer {token}'}
    prods = ['ECO2LSTE.001', 'ECO_L2_LSTE.002']
    layers = [(prods[1], 'LST')]
    prodLayer = [{"layer": l[1], "product": l[0]} for l in layers]
    polyg = Polygon([
        [aoi_coords[0], aoi_coords[1]],
        [aoi_coords[2], aoi_coords[1]],
        [aoi_coords[2], aoi_coords[3]],
        [aoi_coords[0], aoi_coords[3]]
    ])
    aoi_df = gpd.GeoDataFrame(pd.DataFrame(columns=['bbox']), crs='epsg:4326', geometry=[polyg])
    aoi_json = json.loads(aoi_df.to_json())
    startYear, startMonth, startDay = time_range[0][:4], time_range[0][5:7], time_range[0][8:]
    endYear, endMonth, endDay = time_range[1][:4], time_range[1][5:7], time_range[1][8:]
    task = {
        'task_type': 'area',
        'task_name': task_name,
        'params': {
            'dates': [{'startDate': f'{startMonth}-{startDay}-{startYear}', 'endDate': f'{endMonth}-{endDay}-{endYear}'}],
            'layers': prodLayer,
            'output': {'format': {'type': 'geotiff'}, 'projection': 'geographic'},
            'geo': aoi_json
        }
    }
    task_response = req.post(f'{api}task', json=task, headers=head).json()
    if 'task_id' not in task_response:
        raise ValueError(f"Failed to create task: {task_response}")
    task_id = task_response['task_id']
    while req.get(f'{api}task/{task_id}', headers=head).json().get('status') != 'done':
        time.sleep(30)
    if not os.path.exists(local_download_folder):
        os.makedirs(local_download_folder)
    bundle = req.get(f'{api}bundle/{task_id}', headers=head).json()
    if 'files' not in bundle:
        raise ValueError(f"Failed to retrieve files: {bundle}")
    for f in bundle['files']:
        if "LST" in f["file_name"]:
            dl = req.get(f'{api}bundle/{task_id}/{f["file_id"]}', headers=head, stream=True)
            filepath = os.path.join(local_download_folder, f['file_name'].split('/')[-1])
            with open(filepath, 'wb') as file:
                for data in dl.iter_content(chunk_size=8192):
                    file.write(data)
    return local_download_folder

def process_raster_with_dask(raster_path):
    with rasterio.open(raster_path) as src:
        with WarpedVRT(src) as vrt:
            dask_raster = da.from_array(vrt.read(), chunks=(1, 1024, 1024))
            return float(dask_raster.mean(axis=(1, 2)).compute())

def get_weekly_time_range():
    today = datetime.utcnow()
    start = today - timedelta(days=7)
    return [start.strftime("%Y-%m-%d"), today.strftime("%Y-%m-%d")]

def extract_datetime_from_filename(filename):
    try:
        parts = filename.split("_doy")[1]
        year = int(parts[:4])
        day_of_year = int(parts[4:7])
        hour = int(parts[7:9])
        minute = int(parts[9:11])
        second = int(parts[11:13])
        date = datetime(year, 1, 1) + timedelta(days=day_of_year - 1)
        dt_utc = datetime(year, date.month, date.day, hour, minute, second)
        dt_pst = dt_utc - timedelta(hours=7)
        return dt_pst.year, dt_pst.month, dt_pst.day, dt_pst.hour, dt_pst.minute, dt_pst.second
    except Exception as e:
        print(f"Error parsing filename {filename}: {e}")
        return None, None, None, None, None, None

def categorize_temperature(scaled_temp):
    if scaled_temp < 293.15:
        return "Low"
    elif 293.16 <= scaled_temp <= 298.15:
        return "Medium"
    else:
        return "High"

