def update_arcgis_layer(sheet_name, feature_layer):
    df = load_google_sheets_data(sheet_name)
    df.columns = df.columns.str.strip()  # Clean up column names

    # Ensure numeric columns are properly formatted
    df['Mean'] = pd.to_numeric(df['Mean'], errors='coerce').fillna(0.0)
    df['Mean_C'] = pd.to_numeric(df['Mean_C'], errors='coerce').fillna(0.0)
    df['Risk'] = df['Risk'].fillna('Unknown')  # Fill missing Risk values

    # Debugging: Print the first few rows of the DataFrame
    print("Google Sheets DataFrame (first 5 rows):")
    print(df.head())

    # Skip duplicate check for testing purposes
    existing_records = feature_layer.query().sdf
    if "Raster Name" not in df.columns or "Raster_Name" not in existing_records.columns:
        print("ERROR: Column mismatch between Google Sheet and ArcGIS layer.")
        return
    new_records = df[~df["Raster Name"].isin(existing_records["Raster_Name"])]

    # For testing, use all records from the Google Sheet
    new_records = df

    if new_records.empty:
        print("No records to update in ArcGIS.")
        return

    print(f"Appending {len(new_records)} records to ArcGIS Online.")

    # Prepare features for ArcGIS
    features = []
    for _, row in new_records.iterrows():
        features.append({
         "attributes": {
            "Mean": row["Mean"],  # Previously "Scaled_LST"
            "Mean_C": row["Mean_C"],  # Previously "Mean_Celsius"
            "Raster_Name": row["Raster Name"],
            "Risk": row["Risk"],  # Previously "Category"
            "Year": row["Year"],
            "Month": row["Month"],
            "Day": row["Day"],
            "Hour": row["Hour"],
            "Minute": row["Minute"],
            "Second": row["Second"],
            "YYYYMMDD": f"{row['Year']}{row['Month']:0>2}{row['Day']:0>2}"
        }
    })

    # Debugging: Print the first feature being sent to ArcGIS
    print("First feature being sent to ArcGIS:")
    print(features[0])

    # Update the ArcGIS layer
    feature_layer.edit_features(adds=features)
    print("ArcGIS Online feature layer successfully updated with new data!")


